{
  "name": "slimeops-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --preserve-symlinks-main build.mjs && node --preserve-symlinks-main serve.mjs",
    "build": "node --preserve-symlinks-main build.mjs",
    "test": "node --preserve-symlinks-main --experimental-vm-modules --test tests",
    "format": "prettier --write src tests *.mjs *.json",
    "format:check": "prettier --check src tests *.mjs *.json"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
